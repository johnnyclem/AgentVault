# AgentVault Webapp Environment Variables

# Copy to .env.local for actual configuration

# In production, set values in your hosting platform

# Authentication
# Bearer token the /api routes Polytician calls require. Polytician's
# POLYTICIAN_AV_API_TOKEN must equal it.
AGENTVAULT_POLYTICIAN_API_TOKEN=your-secure-api-token-here

# MemoryRepo (/api/memory-repo/*)
# MEMORY_REPO_CANISTER_ID=your-memory-repo-canister-id
# Local replica only; the default is https://ic0.app
# ICP_LOCAL_URL=http://localhost:4943

# Signing identity for memory_repo writes. The canister refuses anonymous
# writes, so without one of these POST /api/memory-repo/commits and
# /tombstone answer 503 SIGNING_IDENTITY_NOT_CONFIGURED. Use an unencrypted
# Ed25519 or secp256k1 PEM, exported outside the project and owner-only:
#   (umask 077; mkdir -p ~/.config/agentvault && dfx identity export <name> > ~/.config/agentvault/<name>.pem)
# and have the repo owner run: agentvault memory authorize <principal>
# (agentvault memory whoami --identity <pem> prints the principal).
# Set one, not both. Never commit the key; the server warns about a key file
# other users can read, and never passes the key to the Polytician it starts.
# AGENTVAULT_ICP_IDENTITY_PEM_FILE=/path/to/agentvault-webapp.pem
# AGENTVAULT_ICP_IDENTITY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Polytician (/api/polytician/[agentId]/*; agentId is the Polytician namespace)
# The command that starts Polytician over stdio; add --config <path> for a
# Polytician config file (else it reads ~/.polytician/config.json).
# POLYTICIAN_ENTRY_POINT=polytician
# This webapp's own base URL (https, or http on localhost). With the token
# above, it is passed to Polytician as POLYTICIAN_AV_API_URL and
# POLYTICIAN_AV_API_TOKEN, so Polytician offers its vault_* tools.
# AGENTVAULT_API_URL=http://localhost:3000

# Inference Configuration
# Get your API key from https://venice.ai
VENICE_API_KEY=your-venice-api-key-here

# Local model (Ollama) endpoint
LOCAL_MODEL_ENDPOINT=http://localhost:11434
# Local model name (default: llama3)
LOCAL_MODEL_NAME=llama3

# Optional: Bittensor configuration (future)
# BITENSOR_API_URL=https://api.bittensor.com
# BITENSOR_WALLET_SEED=your-bittensor-wallet-seed
# BITENSOR_NETUID=1
